<section class="section product-layout"><div>{% for media in product.media %}{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}{% endfor %}</div><div><span class="eyebrow">VEYORA</span><h1 style="font-size:48px">{{ product.title }}</h1><p class="price-large">{{ product.selected_or_first_available_variant.price | money }}</p>{% if product.description != blank %}<div class="rte">{{ product.description }}</div>{% endif %}{% form 'product', product %}{% unless product.has_only_default_variant %}<label for="VariantSelect">Choose option</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="Quantity">Quantity</label><input id="Quantity" name="quantity" type="number" min="1" value="1"><button class="btn" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}<p class="muted">Secure checkout · Cash on Delivery options are configured in Shopify checkout settings.</p></div></section>
{% schema %}{"name":"Main product","settings":[]} {% endschema %}