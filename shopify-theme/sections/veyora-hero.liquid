<section class="hero">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', alt: section.settings.heading }}{% endif %}<div class="hero-copy"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text }}</p>{% if section.settings.button_label != blank %}<a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}</div></section>
{% schema %}{"name":"VEYORA hero","settings":[{"type":"image_picker","id":"image","label":"Campaign image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The new season edit"},{"type":"text","id":"heading","label":"Heading","default":"Elegance in Every Detail."},{"type":"textarea","id":"text","label":"Description","default":"Discover thoughtfully curated fashion for every expression of her style."},{"type":"text","id":"button_label","label":"Button label","default":"Discover the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"VEYORA hero"}]}{% endschema %}