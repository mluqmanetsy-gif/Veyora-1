<section class="veyora-slider" data-veyora-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" aria-label="VEYORA featured collections">
  {% for block in section.blocks %}
    <article class="veyora-slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2200 | image_tag: class: 'veyora-slide-image', loading: 'eager', alt: block.settings.heading }}{% endif %}
      <div class="veyora-slide-shade"></div>
      <div class="veyora-slide-copy">
        {% if block.settings.eyebrow != blank %}<span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>{% endif %}
        <h1>{{ block.settings.heading | escape }}</h1>
        {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
        {% if block.settings.button_label != blank %}<a class="btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{% endif %}
      </div>
    </article>
  {% endfor %}
  {% if section.blocks.size > 1 %}
    <div class="veyora-slider-controls" aria-label="Slide controls">
      <button type="button" data-slide-prev aria-label="Previous slide">‹</button>
      <div class="veyora-slider-dots">{% for block in section.blocks %}<button type="button" data-slide-to="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" class="{% if forloop.first %}is-active{% endif %}"></button>{% endfor %}</div>
      <button type="button" data-slide-next aria-label="Next slide">›</button>
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "VEYORA campaign slider",
  "max_blocks": 6,
  "settings": [
    {"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},
    {"type":"range","id":"interval","label":"Seconds per slide","min":3,"max":12,"step":1,"default":6}
  ],
  "blocks": [
    {"type":"slide","name":"Campaign slide","settings":[
      {"type":"image_picker","id":"image","label":"Campaign image"},
      {"type":"text","id":"eyebrow","label":"Small heading","default":"VEYORA seasonal edit"},
      {"type":"text","id":"heading","label":"Heading","default":"Discover Your Signature Style"},
      {"type":"textarea","id":"text","label":"Description","default":"Explore thoughtfully curated fashion for every expression of her style."},
      {"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},
      {"type":"url","id":"button_link","label":"Button link"}
    ]}
  ],
  "presets":[{"name":"VEYORA campaign slider","blocks":[
    {"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"}
  ]}]
}
{% endschema %}