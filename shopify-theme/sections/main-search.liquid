<section class="section"><div class="section-head"><span class="eyebrow">Find your style</span><h1>Search VEYORA</h1></div><form action="{{ routes.search_url }}" method="get" role="search" style="max-width:620px;margin:0 auto 36px;display:flex;gap:10px"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search clothing, footwear, bags..." style="flex:1;min-width:0"><input type="hidden" name="options[prefix]" value="last"><button class="btn" type="submit">Search</button></form>{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="grid">{% for item in search.results %}{% if item.object_type == 'product' %}<a class="product-card" href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}<h3>{{ item.title }}</h3><div class="price">{{ item.price | money }}</div></a>{% else %}<a href="{{ item.url }}"><h3>{{ item.title }}</h3></a>{% endif %}{% endfor %}</div>{% if search.performed and search.results_count == 0 %}<p>No matching products found. Try another search.</p>{% endif %}{% endif %}</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}