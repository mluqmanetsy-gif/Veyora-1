<section class="section veyora-department-showcase">
  <div class="section-head"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">Shop all</a></div>
  {% if section.settings.banner_image != blank %}<a class="veyora-dept-banner" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.banner_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.heading }}</a>{% else %}<a class="veyora-dept-banner" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}"><img src="https://raw.githubusercontent.com/mluqmanetsy-gif/Veyora-1/main/src/assets/images/{{ section.settings.fallback_banner }}" alt="{{ section.settings.heading | escape }}" loading="lazy"></a>{% endif %}
  <div class="veyora-subcategory-row">{% for block in section.blocks %}<a class="veyora-subcategory-card" href="{{ block.settings.link | default: section.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}<img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% endif %}<span>{{ block.settings.title | escape }}</span></a>{% endfor %}</div>
  {% assign dept_collection = section.settings.collection %}<div class="veyora-dept-products">{% if dept_collection != blank %}{% for product in dept_collection.products limit: 4 %}<a class="product-card" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<h3>{{ product.title }}</h3><div class="price">{{ product.price | money }}</div></a>{% endfor %}{% else %}<p class="veyora-placeholder-note">Choose the matching Shopify collection in the theme editor to display its products here.</p>{% endif %}</div>
</section>
<style>.veyora-dept-banner{display:block;overflow:hidden;border-radius:3px;margin:0 0 22px;max-height:360px;background:#eee5df}.veyora-dept-banner img{display:block;width:100%;height:clamp(170px,28vw,360px);object-fit:cover}.veyora-subcategory-row{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;margin:18px 0 28px}.veyora-subcategory-card{display:block;text-align:center;color:#171513;text-decoration:none;font-size:13px}.veyora-subcategory-card img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:3px;display:block;margin-bottom:8px}.veyora-subcategory-card span{display:block}.veyora-dept-products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.veyora-placeholder-note{grid-column:1/-1;color:#777;font-size:13px;padding:20px 0}@media(max-width:700px){.veyora-subcategory-row{display:flex;overflow-x:auto;gap:12px;padding-bottom:8px}.veyora-subcategory-card{flex:0 0 112px}.veyora-dept-products{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}}</style>
{% schema %}
{"name":"VEYORA department edit","max_blocks":12,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Explore the edit"},{"type":"text","id":"heading","label":"Heading","default":"Department Collection"},{"type":"collection","id":"collection","label":"Shopify collection"},{"type":"image_picker","id":"banner_image","label":"Department banner image"},{"type":"text","id":"fallback_banner","label":"Temporary banner image filename","default":"editorial_pakistani_lawn_1794307449738.jpg"}],"blocks":[{"type":"subcategory","name":"Subcategory tile","settings":[{"type":"text","id":"title","label":"Subcategory name","default":"New styles"},{"type":"url","id":"link","label":"Collection link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"fallback_image","label":"Temporary image URL","default":"https://raw.githubusercontent.com/mluqmanetsy-gif/Veyora-1/main/src/assets/images/cat_pakistani_clothes_1794307402592.jpg"}]}],"presets":[{"name":"Department banner & products"}]}
{% endschema %}