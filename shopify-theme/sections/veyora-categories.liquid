<section class="section"><div class="section-head"><span class="eyebrow">Explore curated departments</span><h2>{{ section.settings.heading }}</h2></div><div class="category-grid">{% for block in section.blocks %}{% assign collection = block.settings.collection %}<a href="{{ collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}{% elsif collection.image %}{{ collection.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}<div style="aspect-ratio:1;background:var(--cream)"></div>{% endif %}<h3>{{ block.settings.title | default: collection.title }}</h3></a>{% endfor %}</div></section>
{% schema %}{"name":"Department circles","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by Department"}],"blocks":[{"type":"department","name":"Department","settings":[{"type":"text","id":"title","label":"Title"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"}]}],"presets":[{"name":"Department circles","blocks":[{"type":"department"},{"type":"department"},{"type":"department"},{"type":"department"},{"type":"department"},{"type":"department"}]}]}{% endschema %}