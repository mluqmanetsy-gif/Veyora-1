<section class="section"><div class="section-head"><span class="eyebrow">Explore curated departments</span><h2>{{ section.settings.heading }}</h2></div><div class="category-grid">{% for block in section.blocks %}{% assign collection = block.settings.collection %}<a href="{{ collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}{% elsif collection.image %}{{ collection.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}{% assign circle_fallbacks = 'cat_pakistani_clothes_1794307402592.jpg,cat_pakistani_innerwear_1794307425111.jpg,cat_pakistani_nightwear_1794307403150.jpg,cat_pakistani_footwear_1794307402024.jpg,cat_pakistani_bags_1794307402870.jpg,cat_pakistani_accessories_1794307426227.jpg' | split: ',' %}<img src="https://raw.githubusercontent.com/mluqmanetsy-gif/Veyora-1/main/src/assets/images/{{ circle_fallbacks[forloop.index0] }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% endif %}<h3>{{ block.settings.title | default: collection.title }}</h3></a>{% endfor %}</div></section>
{% schema %}{"name":"Department circles","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by Department"}],"blocks":[{"type":"department","name":"Department","settings":[{"type":"text","id":"title","label":"Title"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"}]}],"presets":[{"name":"Department circles","blocks":[{"type":"department"},{"type":"department"},{"type":"department"},{"type":"department"},{"type":"department"},{"type":"department"}]}]}{% endschema %}