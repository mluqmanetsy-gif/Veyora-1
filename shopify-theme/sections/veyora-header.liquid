<div class="announcement">{{ settings.announcement }} &nbsp; • &nbsp; <span style="color:var(--gold)">{{ settings.shipping_message }}</span></div>
<header class="site-header"><div class="header-inner"><a href="{{ routes.root_url }}"><span class="brand">VEYORA</span><span class="tagline">Elegance in Every Detail</span></a><nav class="nav"><a href="{{ routes.root_url }}">Home</a>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></nav><button class="btn" data-menu-toggle type="button" aria-expanded="false" aria-controls="VeyoraMobileNav">Menu</button></div><nav id="VeyoraMobileNav" data-mobile-nav class="nav" style="display:none;padding:15px;justify-content:center;flex-wrap:wrap">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a></nav></header>
{% schema %}{"name":"VEYORA header","settings":[{"type":"link_list","id":"menu","label":"Main menu","default":"main-menu"}]}{% endschema %}