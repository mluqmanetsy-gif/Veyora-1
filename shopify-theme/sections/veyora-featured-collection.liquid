<section class="section"><div class="section-head"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">View all</a>{% endif %}</div>{% assign collection = section.settings.collection %}<div class="grid">{% if collection != blank %}{% for product in collection.products limit: section.settings.products_to_show %}<a class="product-card" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<h3>{{ product.title }}</h3><div class="price">{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}</div></a>{% endfor %}{% else %}<p>Select a collection in the theme editor to show real Shopify products.</p>{% endif %}</div></section>
{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Just landed"},{"type":"text","id":"heading","label":"Heading","default":"New Arrivals"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}