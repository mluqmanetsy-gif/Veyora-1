<section class="section"><div class="section-head"><span class="eyebrow">VEYORA collection</span><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div>{% paginate collection.products by 16 %}<div class="grid">{% for product in collection.products %}<a class="product-card" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<h3>{{ product.title }}</h3><div class="price">{{ product.price | money }}</div></a>{% endfor %}</div>{% if paginate.pages > 1 %}<div style="text-align:center;margin-top:30px">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Main collection","settings":[]} {% endschema %}