<section class="section collection-page">
  <div class="section-head">
    <span class="eyebrow">VEYORA collection</span><h1>{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}<div class="rte collection-description">{{ collection.description }}</div>{% endif %}
    <p class="muted">{{ collection.products_count }} pieces</p>
  </div>
  {% paginate collection.products by 16 %}
    <div class="collection-toolbar">
      <label for="CollectionSort">Sort by</label>
      <form method="get" id="CollectionSortForm">
        <select id="CollectionSort" name="sort_by" onchange="this.form.submit()">
          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
          {% for option in collection.sort_options %}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
          {% endfor %}
        </select>
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}
            <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
          {% endfor %}
        {% endfor %}
      </form>
    </div>
    {% if collection.products_count > 0 %}
      <div class="grid">
        {% for product in collection.products %}
          <a class="product-card" href="{{ product.url }}">
            {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% endif %}
            <h3>{{ product.title | escape }}</h3>
            <div class="price">{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}</div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p class="empty-state">No products are currently available in this collection.</p>
    {% endif %}
    {% if paginate.pages > 1 %}<nav class="pagination" role="navigation" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Main collection","settings":[]}
{% endschema %}