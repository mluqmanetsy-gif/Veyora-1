<section class="section veyora-trending">
  <div class="section-head"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a></div>
  {% assign trending_collection = section.settings.collection %}
  {% if trending_collection != blank and trending_collection.products_count > 0 %}
    <div class="veyora-trending-track" data-trending-track>{% for product in trending_collection.products limit: section.settings.products_to_show %}<a class="veyora-trending-card" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<span>{{ product.title }}</span><strong>{{ product.price | money }}</strong></a>{% endfor %}</div>
  {% else %}<p class="veyora-placeholder-note">Select a Shopify collection in the theme editor to show live products in this carousel.</p>{% endif %}
</section>
<style>.veyora-trending{overflow:hidden}.veyora-trending-track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 18px}.veyora-trending-track::-webkit-scrollbar{display:none}.veyora-trending-card{flex:0 0 190px;scroll-snap-align:start;text-decoration:none;color:#171513;display:flex;flex-direction:column;gap:8px;font-size:13px}.veyora-trending-card img{width:100%;aspect-ratio:3/4;object-fit:cover;background:#f6f2ec}.veyora-trending-card strong{font-weight:500}.veyora-trending .section-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #eaeaea;padding-bottom:14px;margin-bottom:22px}.veyora-trending .section-head h2{font:500 36px 'Cormorant Garamond',serif;margin:4px 0}.veyora-trending .eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:#b69a70}@media(max-width:600px){.veyora-trending-card{flex-basis:145px}.veyora-trending .section-head h2{font-size:29px}}</style>
{% schema %}{"name":"VEYORA trending edit","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The VEYORA edit"},{"type":"text","id":"heading","label":"Heading","default":"Trending Now"},{"type":"text","id":"link_label","label":"Link label","default":"Shop the edit"},{"type":"collection","id":"collection","label":"Products collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":16,"step":1,"default":10}],"presets":[{"name":"VEYORA trending edit"}]}{% endschema %}