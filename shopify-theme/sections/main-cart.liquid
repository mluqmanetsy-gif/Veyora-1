<section class="section"><div class="section-head"><h1>Your Bag</h1></div>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div>{% for item in cart.items %}<div style="display:flex;gap:18px;align-items:center;border-bottom:1px solid #eee;padding:18px 0">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: alt: item.title }}{% endif %}<div style="flex:1"><a href="{{ item.url }}">{{ item.product.title }}</a><p>{{ item.variant.title }}</p><p>{{ item.final_line_price | money }}</p><label>Qty <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label></div></div>{% endfor %}</div><p style="text-align:right;font-size:22px">Subtotal: {{ cart.total_price | money }}</p><div style="text-align:right"><button class="btn" type="submit" name="update">Update bag</button> <button class="btn" type="submit" name="checkout">Checkout</button></div></form>{% else %}<p>Your bag is currently empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]} {% endschema %}