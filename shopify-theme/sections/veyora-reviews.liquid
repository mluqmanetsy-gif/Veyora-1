<section class="section veyora-reviews">
  <div class="section-head"><span class="eyebrow">The VEYORA experience</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div>
  {% if section.blocks.size > 0 %}<div class="veyora-review-grid">{% for block in section.blocks %}<article class="veyora-review-card" {{ block.shopify_attributes }}><div class="review-stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div><blockquote>“{{ block.settings.review | escape }}”</blockquote><p class="review-author">{{ block.settings.customer | escape }}{% if block.settings.city != blank %} · {{ block.settings.city | escape }}{% endif %}</p><span class="review-product">{{ block.settings.product | escape }}</span></article>{% endfor %}</div>
  {% else %}<div class="veyora-review-empty"><h3>Your experience matters</h3><p>Customer reviews will appear here once genuine feedback has been collected and approved.</p><a href="https://wa.me/923494968548?text=Salam%20VEYORA%2C%20I%20would%20like%20to%20share%20feedback%20about%20my%20order." class="text-link">Share your feedback</a></div>{% endif %}
</section>
<style>.veyora-reviews{background:#faf8f5}.veyora-reviews .section-head{text-align:center;margin-bottom:26px}.veyora-reviews .eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:#b69a70}.veyora-reviews .section-head h2{font:500 36px 'Cormorant Garamond',serif;margin:6px 0}.veyora-reviews .section-head p{font-size:13px;color:#777}.veyora-review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.veyora-review-card,.veyora-review-empty{background:#fff;border:1px solid #eaeaea;padding:24px}.review-stars{color:#b69a70;letter-spacing:3px}.veyora-review-card blockquote{font:italic 17px 'Cormorant Garamond',serif;line-height:1.6;margin:16px 0}.review-author{font-size:12px;font-weight:600}.review-product{font-size:10px;color:#777}.veyora-review-empty{text-align:center}.veyora-review-empty h3{font:500 24px 'Cormorant Garamond',serif;margin:0}.veyora-review-empty p{font-size:13px;color:#777}@media(max-width:700px){.veyora-review-grid{grid-template-columns:1fr}}</style>
{% schema %}{"name":"VEYORA customer reviews","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Notes from Our Customers"},{"type":"text","id":"description","label":"Description","default":"Real feedback, shared with permission."}],"blocks":[{"type":"review","name":"Approved review","settings":[{"type":"text","id":"customer","label":"Customer name"},{"type":"text","id":"city","label":"City"},{"type":"text","id":"product","label":"Product"},{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"review","label":"Review text"}]}],"presets":[{"name":"VEYORA customer reviews"}]}{% endschema %}