<section id="veyora-ai-studio" class="section veyora-ai-studio">
  <div class="section-head"><span class="eyebrow">Smart style tools</span><h2>VEYORA Fashion Studio</h2><p>Discover pieces, explore your fit and build your personal style edit.</p></div>
  <div class="ai-tabs" role="tablist"><button class="is-active" type="button" data-ai-tab="stylist">Style Finder</button><button type="button" data-ai-tab="size">Size Assistant</button><button type="button" data-ai-tab="wardrobe">Digital Wardrobe</button><button type="button" data-ai-tab="tryon">Virtual Try-On</button><button type="button" data-ai-tab="visual">Visual Search</button><button type="button" data-ai-tab="support">Style Concierge</button></div>
  <div class="ai-panel is-active" data-ai-panel="stylist">
    <h3>Find your VEYORA look</h3><form data-style-form class="ai-form">
      <label>Occasion<select name="occasion"><option>Everyday</option><option>Work & meetings</option><option>Festive & family gathering</option><option>Wedding guest</option><option>Travel & casual</option></select></label>
      <label>Style preference<select name="style"><option>Contemporary Eastern</option><option>Classic Pakistani</option><option>Minimal Western</option><option>Modest elegance</option><option>Relaxed comfort</option></select></label>
      <label>Preferred colour<select name="colour"><option>Neutrals</option><option>Black</option><option>Burgundy</option><option>Pastels</option><option>Jewel tones</option></select></label>
      <label>Budget (PKR)<input name="budget" type="number" min="0" value="10000"></label>
      <button class="btn" type="submit">Find my edit</button>
    </form><div data-style-result class="ai-result" aria-live="polite">Choose your preferences and we’ll show products from the selected VEYORA collection.</div>
    {% assign style_collection = section.settings.style_collection %}
    {% if style_collection != blank %}<div class="ai-product-grid">{% for product in style_collection.products limit: 4 %}<a class="product-card" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<h3>{{ product.title }}</h3><span class="price">{{ product.price | money }}</span></a>{% endfor %}</div>{% endif %}
  </div>
  <div class="ai-panel" data-ai-panel="size"><h3>Smart Size Assistant</h3><p>Enter your measurements in inches for a basic size suggestion. Always compare with the individual product size chart.</p>
    <form data-size-form class="ai-form"><label>Bust (inches)<input name="bust" type="number" min="20" max="70" step="0.5" required placeholder="e.g. 36"></label><label>Waist (inches)<input name="waist" type="number" min="18" max="70" step="0.5" required placeholder="e.g. 30"></label><label>Hips (inches)<input name="hips" type="number" min="20" max="75" step="0.5" required placeholder="e.g. 39"></label><label>Fit preference<select name="fit"><option>Standard</option><option>Relaxed</option><option>Fitted</option></select></label><button class="btn" type="submit">Suggest my size</button></form><div data-size-result class="ai-result" aria-live="polite"></div><p class="ai-disclaimer">This is a general guide, not a guaranteed fit or medical/body assessment.</p>
  </div>
  <div class="ai-panel" data-ai-panel="wardrobe"><h3>My Digital Wardrobe</h3><p>Save your favourite product links on this device and revisit your outfit ideas.</p><form data-wardrobe-form class="ai-form"><label>Outfit name<input name="name" required placeholder="e.g. Eid outfit"></label><label>Product URL<input name="url" type="url" required placeholder="Paste a VEYORA product link"></label><button class="btn" type="submit">Save outfit idea</button></form><div data-wardrobe-list class="ai-result" aria-live="polite">Saved outfit ideas are stored only in this browser.</div></div>
  <div class="ai-panel" data-ai-panel="tryon"><h3>Virtual Try-On</h3><p>Upload a product photo or personal photo only when you are comfortable sharing it.</p><div class="ai-coming">Virtual garment fitting needs an image-processing service. It is not activated in this free theme build yet.</div></div>
  <div class="ai-panel" data-ai-panel="visual"><h3>Visual Product Search</h3><p>Want to find a similar style from a picture?</p><div class="ai-form"><label>Choose an image<input type="file" accept="image/*" disabled></label></div><div class="ai-coming">Image recognition requires an AI image-search service and secure backend. This control will be enabled after that connection is configured.</div></div>
  <div class="ai-panel" data-ai-panel="support"><h3>VEYORA Style Concierge</h3><p>For product, order, size and delivery questions, message our team directly.</p><a class="btn" href="https://wa.me/923494968548?text=Salam%20VEYORA%2C%20I%20need%20help%20with%20my%20order." target="_blank" rel="noopener">Chat on WhatsApp</a><p class="ai-disclaimer">Automated AI chat is not connected yet; WhatsApp opens a real customer-support channel.</p></div>
</section>
<style>
.veyora-ai-studio{background:#f6f2ec}.veyora-ai-studio .section-head p{color:#777}.ai-tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 14px;border-bottom:1px solid #e2d9cf}.ai-tabs button{white-space:nowrap;border:1px solid #ded5cc;background:#fff;padding:11px 15px;font-size:11px;text-transform:uppercase;letter-spacing:.08em;cursor:pointer}.ai-tabs button.is-active{background:#702b3a;color:white;border-color:#702b3a}.ai-panel{display:none;background:#fff;border:1px solid #e7dfd7;padding:26px;margin-top:20px}.ai-panel.is-active{display:block}.ai-panel h3{font-size:27px;margin:0 0 8px}.ai-panel p{font-size:13px;color:#716b65;line-height:1.7}.ai-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;max-width:760px;margin:18px 0}.ai-form label{display:grid;gap:6px;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.ai-form input,.ai-form select{width:100%;background:white}.ai-form .btn{align-self:end}.ai-result,.ai-coming{padding:16px;background:#f6f2ec;margin-top:16px;font-size:13px;line-height:1.7}.ai-disclaimer{font-size:11px!important}.ai-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:20px}.ai-product-grid img{width:100%;aspect-ratio:3/4;object-fit:cover}.ai-product-grid h3{font:500 14px 'Jost',sans-serif;margin:8px 0}.ai-wardrobe-item{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #ddd}.ai-wardrobe-item a{text-decoration:underline}@media(max-width:700px){.ai-form{grid-template-columns:1fr}.ai-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ai-panel{padding:18px}}
</style>
<script>
(function(){
 const root=document.currentScript.closest('.shopify-section');
 if(!root||root.dataset.aiReady)return;root.dataset.aiReady='1';
 const tabs=root.querySelectorAll('[data-ai-tab]'),panels=root.querySelectorAll('[data-ai-panel]');
 tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>x.classList.toggle('is-active',x===t));panels.forEach(p=>p.classList.toggle('is-active',p.dataset.aiPanel===t.dataset.aiTab));}));
 const sf=root.querySelector('[data-style-form]');if(sf)sf.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(sf);const b=Number(d.get('budget'))||0;const result=root.querySelector('[data-style-result]');result.textContent='Your style brief: '+d.get('occasion')+' · '+d.get('style')+' · '+d.get('colour')+' · Budget Rs. '+b.toLocaleString('en-PK')+'. Explore the products shown below and choose the pieces that match your brief.';});
 const zf=root.querySelector('[data-size-form]');if(zf)zf.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(zf),b=+d.get('bust'),w=+d.get('waist');let s='M';if(b<=34&&w<=28)s='XS';else if(b<=37&&w<=31)s='S';else if(b<=40&&w<=34)s='M';else if(b<=43&&w<=37)s='L';else s='XL';if(d.get('fit')==='Relaxed'&&s!=='XL')s=['XS','S','M','L','XL'][['XS','S','M','L','XL'].indexOf(s)+1];root.querySelector('[data-size-result]').textContent='Suggested starting size: '+s+'. Please verify against the exact product measurements before ordering.';});
 const wf=root.querySelector('[data-wardrobe-form]'),list=root.querySelector('[data-wardrobe-list]');const key='veyora_wardrobe_links_v1';function render(){if(!list)return;let arr=[];try{arr=JSON.parse(localStorage.getItem(key)||'[]')}catch(e){}list.innerHTML=arr.length?arr.map((x,i)=>'<div class="ai-wardrobe-item"><span>'+escapeHtml(x.name)+'</span><a href="'+escapeHtml(x.url)+'" target="_blank" rel="noopener">Open</a><button type="button" data-remove-look="'+i+'">Remove</button></div>').join(''):'No saved outfit ideas yet.';}function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}if(wf)wf.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(wf);let arr=[];try{arr=JSON.parse(localStorage.getItem(key)||'[]')}catch(e){}arr.push({name:d.get('name'),url:d.get('url')});localStorage.setItem(key,JSON.stringify(arr));wf.reset();render();});if(list)list.addEventListener('click',e=>{const b=e.target.closest('[data-remove-look]');if(!b)return;let arr=JSON.parse(localStorage.getItem(key)||'[]');arr.splice(+b.dataset.removeLook,1);localStorage.setItem(key,JSON.stringify(arr));render();});render();
})();
</script>
{% schema %}{"name":"VEYORA AI Studio","settings":[{"type":"collection","id":"style_collection","label":"Products for style finder"}],"presets":[{"name":"VEYORA AI Studio"}]}{% endschema %}