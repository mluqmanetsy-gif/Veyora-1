{% assign collection = section.settings.collection %}
<section class="section complete-look">
  <div class="section-head"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div>
  {% if collection != blank %}
    <div class="grid">
      {% for product in collection.products limit: section.settings.products_to_show %}
        <a class="product-card" href="{{ product.url }}">
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% endif %}
          <h3>{{ product.title }}</h3><div class="price">{{ product.price | money }}</div>
        </a>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:30px"><a class="btn" href="{{ collection.url }}">{{ section.settings.button_label | escape }}</a></div>
  {% else %}
    <p class="muted" style="text-align:center">Choose a real Shopify collection in this section's settings to display matching products.</p>
  {% endif %}
</section>
{% schema %}
{"name":"Complete the look","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Style it your way"},
{"type":"text","id":"heading","label":"Heading","default":"Complete the Look"},
{"type":"textarea","id":"description","label":"Description","default":"Discover pieces selected to help you bring your look together."},
{"type":"collection","id":"collection","label":"Product collection"},
{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":4},
{"type":"text","id":"button_label","label":"Button label","default":"Shop the edit"}
],"presets":[{"name":"Complete the look"}]}
{% endschema %}