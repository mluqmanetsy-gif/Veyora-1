:root{--ink:{{ settings.ink | default: '#171513' }};--burgundy:{{ settings.burgundy | default: '#702B3A' }};--gold:{{ settings.gold | default: '#B69A70' }};--cream:{{ settings.cream | default: '#FAF8F5' }}}
*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--cream);font-family:'Jost',sans-serif}h1,h2,h3,.serif{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}.announcement{background:var(--ink);color:#fff;text-align:center;padding:9px 12px;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.site-header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #eaeaea}.header-inner{max-width:1280px;margin:auto;padding:18px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font:600 34px 'Cormorant Garamond',serif;letter-spacing:.22em}.tagline{display:block;color:var(--gold);font-size:9px;letter-spacing:.25em;text-transform:uppercase}.nav{display:flex;gap:24px;align-items:center;font-size:12px;letter-spacing:.12em;text-transform:uppercase}.nav a:hover,.text-link{color:var(--burgundy)}.hero{position:relative;min-height:520px;background:var(--ink);color:#fff;display:flex;align-items:center;overflow:hidden}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.72),transparent)}.hero-copy{position:relative;z-index:1;max-width:1280px;width:100%;margin:auto;padding:70px 7%}.hero h1{font-size:clamp(42px,6vw,76px);max-width:650px;line-height:1.02;margin:16px 0}.eyebrow{color:var(--gold);letter-spacing:.22em;text-transform:uppercase;font-size:11px}.btn{display:inline-block;background:var(--burgundy);color:#fff;padding:15px 25px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;border:0;cursor:pointer}.section{max-width:1280px;margin:auto;padding:60px 24px}.section-head{text-align:center;margin-bottom:32px}.section-head h2{font-size:42px;margin:8px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.product-card img{width:100%;aspect-ratio:3/4;object-fit:cover;background:var(--cream)}.product-card h3{font:500 17px 'Jost',sans-serif;margin:10px 0 4px}.price{font-size:14px}.category-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;text-align:center}.category-grid img{width:100%;aspect-ratio:1;border-radius:50%;object-fit:cover}.category-grid h3{font:500 15px 'Jost',sans-serif}.footer{background:var(--ink);color:#fff;padding:55px 24px;text-align:center}.footer a{color:#e6d8c7}.rte{line-height:1.8}.product-layout{display:grid;grid-template-columns:1.1fr 1fr;gap:45px}.product-layout img{width:100%;height:auto}.muted{color:#777}.price-large{font-size:24px;color:var(--burgundy)}input,select,textarea{padding:12px;border:1px solid #ddd;font:inherit;max-width:100%}@media(max-width:800px){.nav{display:none}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.category-grid{grid-template-columns:repeat(3,1fr);gap:15px}.hero{min-height:470px}.hero-copy{padding:45px 24px}.brand{font-size:28px}.header-inner{padding:14px 16px}.section{padding:42px 16px}.product-layout{grid-template-columns:1fr;gap:24px}}
/* Responsive navigation */
[data-menu-toggle]{display:none}
@media(max-width:800px){[data-menu-toggle]{display:inline-block}[data-mobile-nav]{display:none!important}[data-mobile-nav].is-open{display:flex!important;flex-direction:column;align-items:flex-start;gap:16px;border-top:1px solid #eee}.header-inner>.nav{display:none}}

.veyora-slider{position:relative;min-height:620px;background:var(--ink);color:#fff;overflow:hidden}
.veyora-slide{position:absolute;inset:0;display:flex;align-items:center;opacity:0;visibility:hidden;transition:opacity .8s ease}
.veyora-slide.is-active{position:relative;opacity:1;visibility:visible;min-height:620px}
.veyora-slide-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.veyora-slide-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.38) 55%,rgba(0,0,0,.08)),linear-gradient(0deg,rgba(0,0,0,.35),transparent 55%)}
.veyora-slide-copy{position:relative;z-index:1;width:min(720px,90%);margin:0 auto 0 max(7%,calc((100% - 1280px)/2));padding:70px 0}
.veyora-slide-copy h1,.veyora-slide-copy h2{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(42px,6vw,76px);line-height:1.03;margin:16px 0;max-width:680px}
.veyora-slide-copy p{font-size:16px;line-height:1.8;color:#f0ece8;max-width:560px;margin:0 0 26px}
.veyora-slider-controls{position:absolute;z-index:3;bottom:24px;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:18px}
.veyora-slider-controls>button{border:1px solid rgba(255,255,255,.5);background:rgba(0,0,0,.25);color:#fff;border-radius:50%;width:36px;height:36px;font-size:24px;line-height:1;cursor:pointer}
.veyora-slider-dots{display:flex;gap:9px}
.veyora-slider-dots button{width:22px;height:4px;padding:0;border:0;background:rgba(255,255,255,.5);cursor:pointer}
.veyora-slider-dots button.is-active{width:42px;background:var(--gold)}
@media(max-width:800px){.veyora-slider,.veyora-slide.is-active{min-height:480px}.veyora-slide-copy{margin:0;padding:45px 24px;width:100%}.veyora-slide-copy h1,.veyora-slide-copy h2{font-size:44px}.veyora-slide-copy p{font-size:14px}}

.veyora-editorial{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;background:var(--ink);color:white}
.veyora-editorial-media{min-height:420px}.veyora-editorial-media img{width:100%;height:100%;min-height:420px;object-fit:cover}
.veyora-editorial-copy{align-self:center;padding:70px clamp(28px,7vw,100px)}
.veyora-editorial-copy h2{font-size:clamp(36px,4.5vw,58px);line-height:1.08;margin:12px 0}
.veyora-editorial-copy p{line-height:1.85;color:#eee;margin:0 0 24px}
.complete-look .section-head p{max-width:620px;margin:12px auto 0;color:#777;line-height:1.7}
@media(max-width:800px){.veyora-editorial{grid-template-columns:1fr}.veyora-editorial-media,.veyora-editorial-media img{min-height:300px}.veyora-editorial-copy{padding:42px 24px}}

.product-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-content:start}
.product-gallery-item:first-child{grid-column:span 2}
.product-gallery-item img{width:100%;height:auto;object-fit:cover;background:var(--cream)}
.product-details{position:sticky;top:120px;align-self:start}
.product-title{font-size:clamp(36px,4vw,52px);line-height:1.08;margin:10px 0}
.product-description{margin:22px 0;line-height:1.85}
.product-details form{display:grid;gap:12px;max-width:460px}
.product-details form label{font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.product-details form select,.product-details form input{width:100%}
.product-add-button{width:100%;margin-top:8px}
.product-assurance{font-size:12px;color:#777;line-height:1.7;margin-top:20px}
.form-message{padding:12px;background:var(--cream);margin-top:12px}
.form-message--error{border-left:3px solid var(--burgundy)}
.cart-items{border-top:1px solid #e9e5df}
.cart-item{display:grid;grid-template-columns:130px 1fr auto;gap:22px;padding:22px 0;border-bottom:1px solid #e9e5df;align-items:start}
.cart-item-image img{width:130px;aspect-ratio:3/4;object-fit:cover}
.cart-item-title{font-family:'Cormorant Garamond',serif;font-size:24px}
.cart-item-info p{margin:7px 0;color:#777}
.cart-item-info label{display:block;font-size:12px;margin:12px 0 5px}
.cart-item-info input{width:90px}
.cart-remove{display:inline-block;margin-left:12px;text-decoration:underline;font-size:12px}
.cart-line-total{font-weight:500}
.cart-summary{max-width:520px;margin:30px 0 0 auto}
.cart-subtotal{display:flex;justify-content:space-between;font-size:20px}
.cart-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
.btn-secondary{background:var(--ink)}
.cart-empty{text-align:center;padding:35px 0}
@media(max-width:800px){.product-details{position:static}.product-gallery{grid-template-columns:1fr}.product-gallery-item:first-child{grid-column:auto}.cart-item{grid-template-columns:92px 1fr;gap:14px}.cart-item-image img{width:92px}.cart-line-total{grid-column:2}.cart-actions{flex-direction:column}.cart-actions .btn{width:100%;text-align:center}}

.collection-description{max-width:720px;margin:14px auto}
.collection-toolbar{display:flex;justify-content:flex-end;align-items:center;gap:12px;margin:0 0 24px}
.collection-toolbar form{display:flex}.collection-toolbar select{min-width:180px}
.pagination{text-align:center;margin:36px 0}.pagination a,.pagination span{display:inline-block;padding:8px 12px}
.search-form{max-width:650px;margin:0 auto 32px;display:flex;gap:10px}
.search-form input[type=search]{flex:1;min-width:0}.search-count{margin-bottom:24px;color:#777}
.empty-state{text-align:center;padding:50px 15px;color:#777}
.search-other-result{padding:20px;border-bottom:1px solid #eee}
.footer-inner{max-width:1280px;margin:0 auto 32px;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px;text-align:left}
.footer-inner h3{font:500 20px 'Cormorant Garamond',serif;color:var(--gold)}
.footer-inner p{font-size:13px;line-height:1.7;margin:7px 0}
.footer small{display:block;border-top:1px solid #393431;padding-top:20px}
@media(max-width:800px){.footer-inner{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.search-form{flex-direction:column}.search-form .btn{width:100%}.collection-toolbar{justify-content:space-between}.collection-toolbar select{min-width:150px}}


/* VEYORA product gallery: controlled image sizing, no oversized zoom crop */
.product-gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}
.product-gallery-item{min-width:0;overflow:hidden;background:var(--cream);display:flex;align-items:center;justify-content:center}
.product-gallery-item:first-child{grid-column:span 2}
.product-gallery-item img{display:block;width:100%;height:clamp(320px,48vw,620px);max-height:620px;object-fit:contain;object-position:center;background:var(--cream)}
.product-gallery-item:not(:first-child) img{height:clamp(220px,32vw,420px);max-height:420px}
@media(max-width:800px){
 .product-gallery{grid-template-columns:1fr;gap:12px}
 .product-gallery-item:first-child{grid-column:auto}
 .product-gallery-item img{height:min(118vw,520px);max-height:520px;object-fit:contain}
 .product-gallery-item:not(:first-child) img{height:min(95vw,420px);max-height:420px}
}

/* VEYORA mobile-first product image fit: show the complete garment */
.product-gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.product-gallery-item{min-width:0;background:#f6f2ec;overflow:hidden}
.product-gallery-item:first-child{grid-column:span 2}
.product-gallery-item img{display:block;width:100%;height:auto;max-height:560px;aspect-ratio:4/5;object-fit:contain;object-position:center;background:#f6f2ec}
.product-gallery-item:not(:first-child) img{max-height:420px}
@media(max-width:800px){
 .product-layout{display:flex;flex-direction:column;gap:20px}
 .product-gallery{width:100%;display:grid;grid-template-columns:1fr;gap:10px}
 .product-gallery-item:first-child{grid-column:auto}
 .product-gallery-item img,.product-gallery-item:not(:first-child) img{width:100%;height:auto;max-height:unset;aspect-ratio:4/5;object-fit:contain}
 .product-details{width:100%;position:static}
 .product-title{font-size:34px}
}

/* You may also like — responsive product recommendations */
.veyora-recommendations{padding-top:38px;border-top:1px solid #e9e2dc}
.veyora-recommendations .section-head p{max-width:560px;margin:8px auto 0;color:#777;line-height:1.65}
.veyora-recommendations .product-card{min-width:0;display:block}
.veyora-recommendations .product-card img{width:100%;aspect-ratio:4/5;height:auto;object-fit:contain;background:#f6f2ec}
.veyora-recommendations .product-card h3{font-size:15px;line-height:1.4}
@media(max-width:800px){.veyora-recommendations{padding:34px 16px}.veyora-recommendations .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.veyora-recommendations .product-card img{aspect-ratio:4/5;object-fit:contain}}
