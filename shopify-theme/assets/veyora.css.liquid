:root{--ink:{{ settings.ink | default: '#171513' }};--burgundy:{{ settings.burgundy | default: '#702B3A' }};--gold:{{ settings.gold | default: '#B69A70' }};--cream:{{ settings.cream | default: '#FAF8F5' }}}
*{box-sizing:border-box}body{margin:0;color:var(--ink);background:#fff;font-family:'Jost',sans-serif}h1,h2,h3,.serif{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}.announcement{background:var(--ink);color:#fff;text-align:center;padding:9px 12px;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.site-header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #eaeaea}.header-inner{max-width:1280px;margin:auto;padding:18px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font:600 34px 'Cormorant Garamond',serif;letter-spacing:.22em}.tagline{display:block;color:var(--gold);font-size:9px;letter-spacing:.25em;text-transform:uppercase}.nav{display:flex;gap:24px;align-items:center;font-size:12px;letter-spacing:.12em;text-transform:uppercase}.nav a:hover,.text-link{color:var(--burgundy)}.hero{position:relative;min-height:520px;background:var(--ink);color:#fff;display:flex;align-items:center;overflow:hidden}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.72),transparent)}.hero-copy{position:relative;z-index:1;max-width:1280px;width:100%;margin:auto;padding:70px 7%}.hero h1{font-size:clamp(42px,6vw,76px);max-width:650px;line-height:1.02;margin:16px 0}.eyebrow{color:var(--gold);letter-spacing:.22em;text-transform:uppercase;font-size:11px}.btn{display:inline-block;background:var(--burgundy);color:#fff;padding:15px 25px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;border:0;cursor:pointer}.section{max-width:1280px;margin:auto;padding:60px 24px}.section-head{text-align:center;margin-bottom:32px}.section-head h2{font-size:42px;margin:8px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.product-card img{width:100%;aspect-ratio:3/4;object-fit:cover;background:var(--cream)}.product-card h3{font:500 17px 'Jost',sans-serif;margin:10px 0 4px}.price{font-size:14px}.category-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;text-align:center}.category-grid img{width:100%;aspect-ratio:1;border-radius:50%;object-fit:cover}.category-grid h3{font:500 15px 'Jost',sans-serif}.footer{background:var(--ink);color:#fff;padding:55px 24px;text-align:center}.footer a{color:#e6d8c7}.rte{line-height:1.8}.product-layout{display:grid;grid-template-columns:1.1fr 1fr;gap:45px}.product-layout img{width:100%;height:auto}.muted{color:#777}.price-large{font-size:24px;color:var(--burgundy)}input,select,textarea{padding:12px;border:1px solid #ddd;font:inherit;max-width:100%}@media(max-width:800px){.nav{display:none}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.category-grid{grid-template-columns:repeat(3,1fr);gap:15px}.hero{min-height:470px}.hero-copy{padding:45px 24px}.brand{font-size:28px}.header-inner{padding:14px 16px}.section{padding:42px 16px}.product-layout{grid-template-columns:1fr;gap:24px}}